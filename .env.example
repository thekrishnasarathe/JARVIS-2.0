# ============================================================
# JARVIS 2.0 Environment Configuration Template
# Copy this file to .env and provide your actual API keys.
# ============================================================

# LLM & Reasoning Services
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Weather & External Services
WEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY

# Hardware & Speech Recognition
PORCUPINE_ACCESS_KEY=YOUR_PICOVOICE_PORCUPINE_ACCESS_KEY
JARVIS_WAKE_THRESHOLD=0.5
JARVIS_WAKE_WORD_MODEL=hey_jarvis

# Plugin Architecture
JARVIS_PLUGIN_DIR=plugins

# Spatial Memory Theater Simulation
JARVIS_THEATER_MODE=false
JARVIS_PHYSICS_TICK_MS=500
JARVIS_GRAPH_SAVE_S=60
JARVIS_SIMILARITY_THRESHOLD=0.15

# Deployment & Web Settings
PORT=8000
FRONTEND_URL=http://localhost:3000
